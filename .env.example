# Copy this file to .env once, fill in the real values, and keep .env local.
# .env is git-ignored and is loaded automatically by the CLI/final runners.

# New Vericult backbone via L3S
CULTVERIFY_PROVIDER=l3s
CULTVERIFY_MODEL=YOUR_L3S_MODEL_ID
L3S_API_URL=https://YOUR_L3S_HOST/v1/chat/completions
L3S_API_KEY=YOUR_L3S_API_KEY

# Frozen response generator (model itself is frozen in experiments/generator_freeze.json)
GENERATOR_API_URL=https://inference.kbs.uni-hannover.de/v1/chat/completions

# Evidence retrieval
CULTVERIFY_MODE=LIVE
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Optional legacy/local providers
OLLAMA_URL=http://localhost:11434/api/chat
OPENROUTER_API_KEY=
