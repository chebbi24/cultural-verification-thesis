# Current Vericult 1.1 final experiment: local Ollama backbone + Tavily LIVE retrieval.
# Export these variables in your shell; .env is NOT loaded automatically.
CULTVERIFY_PROVIDER=ollama
# The local Ollama digest is captured by scripts/preflight_final_experiment.py.
CULTVERIFY_MODEL=qwen3:4b
OLLAMA_URL=http://localhost:11434/api/chat
CULTVERIFY_MODE=LIVE
TAVILY_API_KEY=

# Best-of-4 v2 strong-model generation through OpenRouter.
OPENROUTER_API_KEY=
