# Current verifier-v1 experiment: local Ollama backbone + Tavily LIVE retrieval.
# Export these variables in your shell; .env is NOT loaded automatically.
CULTVERIFY_PROVIDER=ollama
# Pin the exact model/revision for the final freeze.
CULTVERIFY_MODEL=qwen3:4b
OLLAMA_URL=http://localhost:11434/api/chat
CULTVERIFY_MODE=LIVE
TAVILY_API_KEY=
